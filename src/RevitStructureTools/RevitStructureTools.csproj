<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <TargetFramework>net47</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>RevitStructureTools</AssemblyName>
    <RootNamespace>RevitStructureTools</RootNamespace>
    <Version>1.0.0</Version>
    <RevitVersion Condition="'$(RevitVersion)' == ''">2019</RevitVersion>
    <TargetFramework Condition="'$(RevitVersion)' == '2021'">net48</TargetFramework>
    <OutputPath>bin/$(RevitVersion)/$(Configuration)/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <RevitInstallDir Condition="'$(RevitInstallDir)' == ''">C:\Program Files\Autodesk\Revit $(RevitVersion)</RevitInstallDir>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetLockFilePath>packages.$(RevitVersion).lock.json</NuGetLockFilePath>
  </PropertyGroup>
  <ItemGroup Condition="'$(RevitVersion)' == '2019'">
    <PackageReference Include="Revit.RevitApi.x64" Version="[2019.0.0]" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Revit.RevitApiUI.x64" Version="[2019.0.0]" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup Condition="'$(RevitVersion)' == '2021'">
    <Reference Include="RevitAPI"><HintPath>$(RevitInstallDir)\RevitAPI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="RevitAPIUI"><HintPath>$(RevitInstallDir)\RevitAPIUI.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="CheckRevitVersion" BeforeTargets="PrepareForBuild" Condition="'$(RevitVersion)' != '2019' and '$(RevitVersion)' != '2021'">
    <Error Text="Supported RevitVersion values: 2019, 2021." />
  </Target>
</Project>
